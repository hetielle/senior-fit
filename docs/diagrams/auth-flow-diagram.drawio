        <!-- ===== LOGIN FLOW ===== -->
        <mxCell id="login-header" value="2. LOGIN (UC02)" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
