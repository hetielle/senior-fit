        <!-- ===== SESSION CHECK FLOW ===== -->
        <mxCell id="session-header" value="3. VERIFICAÇÃO DE SESSÃO (por requisição ao servidor)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
