        <!-- ===== SIGNUP FLOW ===== -->
        <mxCell id="signup-header" value="1. CADASTRO (UC01)" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="1260" height="30" as="geometry" />
        </mxCell>

        <!-- Signup: User fills form -->
        <mxCell id="su-form" value="Usuário preenche&#xa;/sign-up&#xa;(nome, email, senha)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="160" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Signup: authClient.signUp.email() -->
        <mxCell id="su-client-call" value="authClient.signUp.email()&#xa;POST /api/auth/sign-up/email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="250" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Signup: Next.js receives -->
